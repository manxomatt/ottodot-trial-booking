# Matches the docker-compose.yml in this repo.
DATABASE_URL=postgres://ottodot:ottodot@localhost:5433/ottodot
TEST_DATABASE_URL=postgres://ottodot:ottodot@localhost:5433/ottodot_test

# How long a parent has to pay before their seat goes back on sale.
# Set it to something tiny if you want to watch a hold expire during the demo.
HOLD_TTL_MINUTES=10
